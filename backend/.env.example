# Copy this file to .env and fill in real values. Never commit .env.
# Var list must stay in sync with anchor.md/TECH_STACK.md and anchor.md/SECURITY.md.

DATABASE_URL=sqlite:///./venturemind.db

# Which LLM provider services/llm_service.py routes to via LiteLLM: "groq" or "gemini".
LLM_PROVIDER=groq

GROQ_API_KEY=
# LiteLLM model id, without the "groq/" prefix (services/llm_service.py adds it).
# Check this is still current before relying on it — model catalogs move.
GROQ_MODEL=openai/gpt-oss-120b

# Only needed if LLM_PROVIDER=gemini (or HEAVY_LLM_PROVIDER=gemini, the default).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Provider used only by the two agents whose prompts aggregate ALL research
# findings at once (Executive Decision, Report Generator) — those prompts are
# far bigger than the rest of the graph's calls, so they're routed separately
# to avoid blowing a small model's per-minute token budget on a single call.
HEAVY_LLM_PROVIDER=gemini

TAVILY_API_KEY=
FIRECRAWL_API_KEY=

CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
# Executive Decision Agent loop (see anchor.md/DECISIONS.md Decision 012) —
# optional, both have sensible defaults in core/config.py.
SCORE_THRESHOLD=70.0
MAX_ITERATIONS=2
# If a venture is stuck at status=running (e.g. the server restarted mid-run)
# longer than this, /validate treats it as dead and allows a fresh run
# instead of returning 409 forever. Optional, defaults to 600 in core/config.py.
STALE_RUN_TIMEOUT_SECONDS=600
